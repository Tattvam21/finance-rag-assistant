# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=qwen3:8b
EMBED_MODEL=bge-m3
EMBED_DIM=1024
NUM_CTX=8192
SIMILARITY_THRESHOLD=0.45
GATE_MODEL=qwen3:8b
RETRIEVAL_STRATEGY=hybrid
GATE_MODE=merged
PLANNER_MODE=auto

# Database Configuration
DB_BACKEND=postgres
POSTGRES_USER=postgres
# PostgreSQL database password (set your secure password here)
POSTGRES_PASSWORD=
POSTGRES_DB=finance_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full database connection URL (leave blank to construct from POSTGRES_* or set postgresql://USER:PASSWORD@HOST:PORT/DB)
DATABASE_URL=

# Evaluation & Policy As-of Date
AS_OF_DATE=2024-08-05
